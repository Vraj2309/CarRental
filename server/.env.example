# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/car-rental

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Where the React app runs (allowed by CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (Dashboard > API Keys). Image upload is disabled if these are empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay TEST keys (Dashboard > Account & Settings > API Keys). Payments are disabled if empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Used once by `npm run create-admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@carrental.dev
ADMIN_PASSWORD=ChangeMe@123
